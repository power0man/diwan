{"id": "restore-old-research-stop-filter", "file": "evaluation/research_runner.py", "old": "if run.status != \"complete\":", "new": "if run.status in (\"refused\", \"failed\"):", "tests": ["tests/test_research_unfinished_turns.py::test_provider_stops_are_named_errors_without_scoring[max_output-truncated]", "tests/test_research_unfinished_turns.py::test_provider_stops_are_named_errors_without_scoring[deadline-timed_out]", "tests/test_research_unfinished_turns.py::test_exhausting_search_steps_never_scores_the_intermediate_answer", "tests/test_research_unfinished_turns.py::test_a_new_unfinished_status_falls_back_to_its_name_without_scoring"], "why": "Restores the original bug: unfinished answers reach scoring."}
{"id": "lose-research-stop-status", "file": "evaluation/research_runner.py", "old": "\"code\": run.code or run.status, \"loop_status\": run.status", "new": "\"code\": run.code or run.status", "tests": ["tests/test_research_unfinished_turns.py::test_provider_stops_are_named_errors_without_scoring"], "why": "Named provider errors must retain the original loop state, including refusal and failure."}
{"id": "lose-research-code-fallback", "file": "evaluation/research_runner.py", "old": "\"code\": run.code or run.status", "new": "\"code\": run.code", "tests": ["tests/test_research_unfinished_turns.py::test_a_new_unfinished_status_falls_back_to_its_name_without_scoring"], "why": "A future unfinished state without a code must still have a named error."}
{"id": "mislabel-new-research-report-as-v1", "file": "evaluation/research_runner.py", "old": "RUNNER_VERSION = 2", "new": "RUNNER_VERSION = 1", "tests": ["tests/test_research_unfinished_turns.py::test_complete_reports_and_search_ablation_identify_research_runner_v2"], "why": "Reports must distinguish the changed scoring population from v1."}
{"id": "omit-search-ablation-runner-version", "file": "tools/evaluate_ablation.py", "old": "config[\"research_runner_version\"] = RESEARCH_RUNNER_VERSION", "new": "pass", "tests": ["tests/test_research_unfinished_turns.py::test_complete_reports_and_search_ablation_identify_research_runner_v2"], "why": "Embedded research results also need the runner version."}
