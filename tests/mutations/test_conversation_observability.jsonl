{"id": "observer-usage", "file": "conversation/observability.py", "old": "\"input_tokens\": getattr(usage, \"input_tokens\", None)", "new": "\"input_tokens\": None", "tests": ["tests/test_conversation_observability.py::test_provider_result_and_usage_preserved_without_payload"], "why": "Actual validated response usage reaches metadata."}
{"id": "observer-error", "file": "conversation/observability.py", "old": "code = getattr(provider_error, \"code\", \"operation_error\")", "new": "code = \"none\"", "tests": ["tests/test_conversation_observability.py::test_provider_error_identity_and_named_code_preserved"], "why": "Known provider errors retain their named closed metadata classification."}
{"id": "observer-failure", "file": "conversation/observability.py", "old": "except Exception:\n                pass  # Telemetry", "new": "except Exception:\n                raise  # Telemetry", "tests": ["tests/test_conversation_observability.py::test_observer_failure_keeps_success_result", "tests/test_conversation_observability.py::test_observer_failure_keeps_original_exception", "tests/test_conversation_observability.py::test_chat_observer_failure_keeps_durable_result", "tests/test_conversation_observability.py::test_agent_session_observer_failure_keeps_success"], "why": "Observer exceptions cannot replace provider or durable session results."}
{"id": "observer-chat-hook", "file": "conversation/session.py", "old": "execute(req, observed(provider, self.observer), Budget(0, 0), ledger)", "new": "execute(req, provider, Budget(0, 0), ledger)", "tests": ["tests/test_conversation_observability.py::test_chat_replay_does_not_emit_or_generate_again"], "why": "The real chat session must invoke metadata only for new provider calls."}
{"id": "observer-locality", "file": "conversation/observability.py", "old": "return is_local_provider(self.provider)", "new": "return True", "tests": ["tests/test_conversation_observability.py::test_observation_cannot_make_remote_provider_local", "tests/test_conversation_observability.py::test_wrapper_checks_current_provider_locality_instead_of_cached_local_flag"], "why": "The wrapper must preserve current locality rather than promote or cache a stale local flag."}
{"id": "observer-agent-hook", "file": "conversation/agent_session.py", "old": "_ProviderGuard(self, state, turn, observed(provider, self.observer))", "new": "_ProviderGuard(self, state, turn, provider)", "tests": ["tests/test_conversation_observability.py::test_agent_session_real_boundary_and_replay"], "why": "Agent sessions use the provider metadata boundary without duplicate replay calls."}
{"id": "observer-response-error", "file": "conversation/observability.py", "old": "code = \"response_error\"", "new": "code = \"none\"", "tests": ["tests/test_conversation_observability.py::test_response_error_is_distinct_from_success"], "why": "Returned provider errors are distinct from a successful transport response."}
{"id": "observer-capacity", "file": "conversation/observability.py", "old": "if type(capacity) is not int or not 1 <= capacity <= 1024:", "new": "if False:", "tests": ["tests/test_conversation_observability.py::test_local_collector_capacity_rejects_unbounded_or_boolean_values"], "why": "Invalid capacities fail before loading the optional SDK."}
{"id": "observer-exception-success-label", "file": "conversation/observability.py", "old": "if type(code) is not str or code not in ERRORS - {\"none\"}:", "new": "if False:", "tests": ["tests/test_conversation_observability.py::test_exception_cannot_label_itself_success"], "why": "A raised exception is not a successful provider call even if its code claims none."}
{"id": "observer-error-getter-boundary", "file": "conversation/observability.py", "old": "provider_error = exc\n            raise", "new": "provider_error = exc\n            getattr(exc, \"code\", \"operation_error\")\n            raise", "tests": ["tests/test_conversation_observability.py::test_error_metadata_getter_cannot_replace_original_exception"], "why": "Exception-code metadata must not be read outside the isolated metadata block, where a failing descriptor replaces the original exception."}
{"id": "observer-response-getter-boundary", "file": "conversation/observability.py", "old": "code = \"none\"\n            return response", "new": "code = \"response_error\" if isinstance(response, Response) and response.retryable_error else \"none\"\n            return response", "tests": ["tests/test_conversation_observability.py::test_response_metadata_getter_cannot_replace_original_result"], "why": "Response-flag metadata must not be read before returning under the isolated finally block."}
