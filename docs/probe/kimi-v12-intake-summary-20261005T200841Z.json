  "tree_manifest_method": "entries_of_relative_path_bytes_sha256_sorted_by_relative_path_utf8_json_ensure_ascii_false_sort_keys_true_compact_separators_plus_newline_then_sha256",
  "tree_manifest_script": "import argparse\nimport hashlib\nimport json\nfrom pathlib import Path\n\nparser = argparse.ArgumentParser()\nparser.add_argument(\"root\", type=Path)\nparser.add_argument(\"out\", type=Path)\nargs = parser.parse_args()\nroot = args.root\nentries = []\nfor path in sorted(root.rglob(\"*\")):\n    relative = path.relative_to(root)\n    if \"sealed\" in relative.parts or path.is_symlink():\n        raise SystemExit(\"blocked_path_or_symlink\")\n    if not path.is_file():\n        continue\n    raw = path.read_bytes()\n    entries.append({\"path\": relative.as_posix(), \"bytes\": len(raw),\n                    \"sha256\": hashlib.sha256(raw).hexdigest()})\ncanonical = (json.dumps(entries, ensure_ascii=False, sort_keys=True,\n                        separators=(\",\", \":\")) + \"\\n\").encode(\"utf-8\")\npayload = {\"method\": \"sha256_utf8_canonical_relative_file_manifest_v1\",\n           \"files\": len(entries), \"delivery_tree_sha256\": hashlib.sha256(canonical).hexdigest(),\n           \"entries\": entries}\nwith args.out.open(\"x\", encoding=\"utf-8\") as stream:\n    json.dump(payload, stream, ensure_ascii=False, indent=2)\n    stream.write(\"\\n\")\nprint(json.dumps({key: payload[key] for key in (\"files\", \"delivery_tree_sha256\")}))\n",
