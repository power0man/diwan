__pycache__/
*.pyc
.pytest_cache/
.venv/
.env
*.env
# بيانات القبول المحجوبة — خارج شجرة المصدر المنشورة
evaluation/holdout/
# السجل: أثرُ تشغيلٍ لا مصدر — إلا سجلات الحقيقة المدفوعة (استثناءات أدناه)
var/
*.jsonl
!sources/*.jsonl
!corpus/**/*.jsonl
!glossaries/*.jsonl
!rulings/*.jsonl
!registry/
!publish/*.jsonl
# مخزن المعاجم الكبيرة محلي (فوق طاقة git بلا LFS — قرار م٥ المعلن)
corpus/lexicons-local/
# التيارات والسجل الرئيس حالةُ تشغيلٍ تُصفَّر — لا حقيقة مدفوعة (م٥)
streams/
ledger/
# الإسقاطات تُشتق ولا تُدفع — أمّا شيفرةُ بنائها فمصدرٌ يُدفع.
# «projections/» وحدَها كانت تبتلع الشيفرةَ أيضًا، فكان ملفٌّ يُكتب هنا
# ولا يدخل المستودع أبدًا ولا يُنبَّه كاتبُه (م١٤ — الخطوة ١.٢).
projections/*
!projections/*.py

# أقفال flock الجانبية للسجلات — حالة تشغيل لا حقيقة (uv.lock ليس منها)
*.jsonl.lock

# قواعد بيانات الفهرسة المشتقة محلياً
*.db

.agents/
ORIGINAL_REQUEST.md

# الشطرُ المحجوب من بنوك القياس المستقلّة: محتواه لا يدخل المستودع أبدًا.
# يُنشر البيانُ المختوم وحدَه (بصماتٌ وأعدادٌ بلا محتوى) ليُثبَت لاحقًا
# أنّ المحجوبَ لم يُبدَّل بعد ظهور النتيجة.
evaluation/banks/*/sealed/*
!evaluation/banks/*/sealed/MANIFEST.json
