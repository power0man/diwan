__pycache__/
*.pyc
.pytest_cache/
.venv/
.env
*.env
# بيانات القبول المحجوبة — خارج شجرة المصدر المنشورة
evaluation/holdout/
# السجل: أثرُ تشغيلٍ لا مصدر — إلا سجلات الحقيقة المدفوعة (استثناءات أدناه)
var/
*.jsonl
!rulings/*.jsonl
!registry/
!registry/*.jsonl
# سجلُّ المسائل (ك٤١): إثباتٌ مدفوع لا أثرُ تشغيل
!docs/TASKS.jsonl
# مخزن المعاجم الكبيرة محلي (فوق طاقة git بلا LFS — قرار م٥ المعلن)
corpus/lexicons-local/
# التيارات والسجل الرئيس حالةُ تشغيلٍ تُصفَّر — لا حقيقة مدفوعة (م٥)
streams/
ledger/
# الإسقاطات تُشتق ولا تُدفع — أمّا شيفرةُ بنائها فمصدرٌ يُدفع.
# «projections/» وحدَها كانت تبتلع الشيفرةَ أيضًا، فكان ملفٌّ يُكتب هنا
# ولا يدخل المستودع أبدًا ولا يُنبَّه كاتبُه (م١٤ — الخطوة ١.٢).
projections/*
!projections/*.py

# أقفال flock الجانبية للسجلات — حالة تشغيل لا حقيقة (uv.lock ليس منها)
*.jsonl.lock

# قواعد بيانات الفهرسة المشتقة محلياً
*.db

.agents/
ORIGINAL_REQUEST.md

# الشطرُ المحجوب من بنوك القياس المستقلّة: محتواه لا يدخل المستودع أبدًا.
# يُنشر البيانُ المختوم وحدَه (بصماتٌ وأعدادٌ بلا محتوى) ليُثبَت لاحقًا
# أنّ المحجوبَ لم يُبدَّل بعد ظهور النتيجة.
evaluation/banks/*/sealed/*
!evaluation/banks/*/sealed/MANIFEST.json

# مخازنُ المالك الخاصة (ك٢٧، ق٥١، ق٥٢): تبقى في Drive وفي diwan-private، وتوضع محليًّا
# بـtools/place_private_stores.py ولا تدخل المستودعَ العام أبدًا. القائمةُ مصدرُها
# tools/export_public.py::EXCLUDED_PATHS، والحارس tests/test_private_stores_are_ignored.py.
# وما ضمّنه المالك في العام (INCLUDED_PATHS، ق٥٨: القاموسُ المحيط) يُعاد تضمينُه نفيًا بعد نفي،
# لأن git لا يُعيد ملفًّا تحت دليلٍ متجاهَلٍ كلُّه.
corpus/*
!corpus/lexicons/
corpus/lexicons/*
!corpus/lexicons/qamus-muhit.jsonl
!corpus/lexicons/qamus-muhit.jsonl.anchor
glossaries/
sources/
publish/
evaluation/suites/benchmark_m14.json
nodes/maritime/evidence/golden-answers.json
services/evidence/research-m6.json
docs/probe/m14-human-sample-review.json
nodes/linguistics/evidence/roots-20.json
